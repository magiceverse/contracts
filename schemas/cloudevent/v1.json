{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://contracts.magiceverse.dev/cloudevent/v1",
    "version": "1.0.0",
    "title": "CloudEvent",
    "description": "Webhook envelope: a CloudEvents 1.0 structured-mode event whose data is a Product.",
    "type": "object",
    "additionalProperties": false,
    "required": ["specversion", "type", "source", "id", "time", "subject", "datacontenttype", "data", "tenant"],
    "properties": {
        "specversion": { "const": "1.0" },
        "type": { "enum": ["dev.magiceverse.product.updated", "dev.magiceverse.product.deleted"] },
        "source": {
            "description": "https://<tenant host> of the sending system.",
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/]+$"
        },
        "id": {
            "$ref": "https://contracts.magiceverse.dev/common/v1#/$defs/ulid",
            "description": "Unique per event; receivers deduplicate on (source, id)."
        },
        "time": { "$ref": "https://contracts.magiceverse.dev/common/v1#/$defs/timestamp" },
        "subject": {
            "$ref": "https://contracts.magiceverse.dev/common/v1#/$defs/ulid",
            "description": "Uid of the product in data."
        },
        "datacontenttype": { "const": "application/json" },
        "data": { "$ref": "https://contracts.magiceverse.dev/product/v1" },
        "tenant": {
            "description": "Extension attribute: slug of the sending tenant.",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "correlationid": {
            "description": "Extension attribute: ties the event to the request or job that caused it.",
            "type": "string",
            "minLength": 1
        }
    },
    "allOf": [
        {
            "description": "A deleted event carries a tombstone.",
            "if": {
                "properties": { "type": { "const": "dev.magiceverse.product.deleted" } }
            },
            "then": {
                "properties": {
                    "data": {
                        "required": ["deleted_at"],
                        "properties": { "deleted_at": { "type": "string" } }
                    }
                }
            }
        },
        {
            "description": "An updated event carries a live product.",
            "if": {
                "properties": { "type": { "const": "dev.magiceverse.product.updated" } }
            },
            "then": {
                "properties": {
                    "data": {
                        "properties": { "deleted_at": { "type": "null" } }
                    }
                }
            }
        }
    ]
}
